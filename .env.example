AI_API_KEY=sk-...
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
DB_PATH=metrics.sql

# Notifier backend: "telegram" (default if unset) or "discord". Only one is needed.
NOTIFIER=telegram

# Required when NOTIFIER=telegram
TG_BOT_TOKEN=123456:AA...
TG_CHAT_ID=123456789

# Optional: use Discord instead of Telegram.
# Set NOTIFIER=discord and fill this in — the TG_* vars are then not required.
# Get the URL in Discord: Channel Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/123.../abc...

# Optional: HTTP timeout in seconds for Telegram/Discord requests (must be positive, default 10)
# REQUEST_TIMEOUT=30

# Optional: how many days of metrics/device-scan history to keep before old rows
# are pruned (checked once per detailed-report cycle, default 90)
# RETENTION_DAYS=90
