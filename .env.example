# Core local storage and scheduling
DB_PATH=/var/lib/netmon/metrics.sql
GRAPH_PATH=/opt/netmon/graphs/network_speed_test.png
RUN_NOW_FLAG=/var/lib/netmon/run-now
SECURE_SETTINGS_PATH=/var/lib/netmon/private-settings.json
COLLECTION_INTERVAL=1800

# Authenticated local dashboard
WEB_HOST=0.0.0.0
WEB_PORT=8000

# HTTP/API request timeout in seconds
REQUEST_TIMEOUT=30

# The administrator password hash, Flask session secret, Groq API key and
# Remote AI switch are managed through the authenticated dashboard and are
# deliberately absent from this environment file.
